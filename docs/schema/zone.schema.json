{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klyro.dev/zone.schema.json",
  "title": "Klyro DNS Zone Configuration",
  "description": "Zone file defining a DNS zone and its records.",
  "type": "object",
  "required": ["name", "type"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this JSON Schema file."
    },
    "name": {
      "type": "string",
      "description": "The domain name for this zone.",
      "pattern": "^([a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)*[a-zA-Z]{2,}$",
      "examples": ["example.com", "home.local"]
    },
    "type": {
      "type": "string",
      "description": "The zone type.",
      "enum": ["primary", "secondary", "stub", "forward"],
      "default": "primary"
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether this zone is active and served.",
      "default": true
    },
    "records": {
      "type": "array",
      "description": "DNS records for this zone.",
      "items": {
        "type": "object",
        "required": ["name", "type", "value"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Record name relative to the zone. Use '@' for the zone root.",
            "minLength": 1,
            "examples": ["@", "www", "api", "mail"]
          },
          "type": {
            "type": "string",
            "description": "DNS record type.",
            "enum": ["A", "AAAA", "CNAME", "MX", "TXT", "NS", "SOA", "SRV", "PTR", "CAA"]
          },
          "ttl": {
            "type": "integer",
            "description": "Time to live in seconds.",
            "minimum": 0,
            "maximum": 86400,
            "default": 3600
          },
          "value": {
            "type": "string",
            "description": "Record value. Format depends on record type.",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "description": "Record priority. Required for MX and SRV records.",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "A" } } },
            "then": { "properties": { "value": { "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$" } } }
          },
          {
            "if": { "properties": { "type": { "const": "AAAA" } } },
            "then": { "properties": { "value": { "pattern": "^([0-9a-fA-F:]+)$" } } }
          },
          {
            "if": { "properties": { "type": { "const": "MX" } } },
            "then": { "required": ["priority"] }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
